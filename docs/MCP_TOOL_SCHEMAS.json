          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Inbound Transfer Ids"
      },
      "deadline_seconds": {
        "default": 600,
        "title": "Deadline Seconds",
        "type": "integer"
      },
      "memory_mb": {
        "default": 2048,
        "title": "Memory Mb",
        "type": "integer"
      },
