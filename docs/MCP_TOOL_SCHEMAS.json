        "anyOf": [
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Dependency Job Ids"
      }
    },
    "required": [
      "assignment",
      "acceptance_criteria",
      "project_id",
      "authority"
